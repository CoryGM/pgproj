          "name": "order_totals",
          "qualifiedName": "shop.order_totals",
          "description": "Each order\u0027s total, with a display form in its currency.",
          "schema": "shop",
          "materialized": false,
          "columns": [
            {
              "name": "order_id",
              "type": "pg_catalog.int8"
            },
            {
              "name": "customer",
              "type": "text"
            },
            {
              "name": "status",
              "type": "shop.order_status"
            },
            {
              "name": "total"
            },
            {
              "name": "total_display"
            }
          ],
          "definition": "SELECT o.id AS order_id,\r\n       c.name AS customer,\r\n       o.status,\r\n       sum(l.quantity * l.unit_price) AS total,\r\n       platform.format_money(sum(l.quantity * l.unit_price), o.currency) AS total_display\r\nFROM orders o\r\nJOIN customers c ON c.id = o.customer_id\r\nJOIN order_lines l ON l.order_id = o.id\r\nGROUP BY o.id, c.name, o.status, o.currency"
        }
