<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Identity and version (G-81): Identity.props, shared with the CLI, so one tag versions both. -->
  <Import Project="..\Identity.props" />

  <!--
    The NuGet package PgProj.Engine (G-319): the engine with the six assemblies it is built on (Core, Parser, Semantics, Dependencies, Diff,
    Deploy) inside it, since its results carry some of their types, and libpg_query for the platforms it is built for. Only the engine's API is
    promised (PublicApi.txt); the inner assemblies are not packages of their own. Not author-signed: nuget.org signs every package it publishes.
  -->
  <PropertyGroup>
    <PackageId>PgProj.Engine</PackageId>
    <Product>pgproj</Product>
    <Description>pgproj as a library: build a PostgreSQL schema project from SQL files, compare it with a live database, plan and publish the difference, scaffold a project from a database, and document it. Runs on win-x64, win-arm64, linux-x64, linux-arm64, and osx-arm64.</Description>
    <PackageTags>postgresql;postgres;schema;migration;database-project;ddl;sql;libpg_query</PackageTags>
    <PackageProjectUrl>https://github.com/CoryGM/pgproj</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Every public member is documented in XML, which the package carries for IntelliSense: a member without a comment fails the build (CS1591).
         A record's parameters need not each have a param tag (CS1573). -->
    <NoWarn>$(NoWarn);CS1573</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);PackInnerAssemblies</TargetsForTfmSpecificBuildOutput>
    <TargetsForTfmSpecificDebugSymbolsInPackage>$(TargetsForTfmSpecificDebugSymbolsInPackage);PackInnerSymbols</TargetsForTfmSpecificDebugSymbolsInPackage>
  </PropertyGroup>

  <!-- The pipeline as a library (G-309): no console, no System.CommandLine, no exit codes. A shell (the CLI, an editor, a web API) calls it
       and renders what it returns. PrivateAssets: these are packed inside the engine's package (PackInnerAssemblies), not depended on as packages,
       so a project that references this one references them itself. -->
  <ItemGroup>
    <ProjectReference Include="..\PgProj.Core\PgProj.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\PgProj.Parser\PgProj.Parser.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\PgProj.Semantics\PgProj.Semantics.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\PgProj.Dependencies\PgProj.Dependencies.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\PgProj.Diff\PgProj.Diff.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\PgProj.Deploy\PgProj.Deploy.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- What the inner assemblies need from NuGet, as the package's own dependencies: Npgsql, the version PgProj.Core references. -->
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <!--
    libpg_query, as PgProj.Parser takes it from Npgquery (only its native libraries, renamed as the platform names them), packed under
    runtimes/<rid>/native for the five runtimes it is built for: a consumer's build copies them where PgQueryInterop looks, and a publish for one
    runtime keeps that runtime's. buildTransitive/PgProj.Engine.targets fails a consumer's build for any other runtime.
  -->
  <ItemGroup>
    <PackageReference Include="Npgquery" Version="1.2.0" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all">
      <IncludeAssets>none</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(PkgNpgquery)/runtimes/win-x64/native/pg_query.dll" Pack="true" PackagePath="runtimes/win-x64/native/libpg_query.dll" Visible="false" />
    <None Include="$(PkgNpgquery)/runtimes/win-arm64/native/pg_query.dll" Pack="true" PackagePath="runtimes/win-arm64/native/libpg_query.dll" Visible="false" />
    <None Include="$(PkgNpgquery)/runtimes/linux-x64/native/libpg_query.so" Pack="true" PackagePath="runtimes/linux-x64/native/libpg_query.so" Visible="false" />
    <None Include="$(PkgNpgquery)/runtimes/linux-arm64/native/libpg_query.so" Pack="true" PackagePath="runtimes/linux-arm64/native/libpg_query.so" Visible="false" />
    <None Include="$(PkgNpgquery)/runtimes/osx-arm64/native/libpg_query.dylib" Pack="true" PackagePath="runtimes/osx-arm64/native/libpg_query.dylib" Visible="false" />
    <None Include="buildTransitive/PgProj.Engine.targets" Pack="true" PackagePath="buildTransitive/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../NOTICE" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <!-- The inner assemblies and their symbols, from the project references' outputs, into lib/ and the symbol package. -->
  <Target Name="PackInnerAssemblies" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference')->WithMetadataValue('Extension', '.dll'))" />
    </ItemGroup>
  </Target>

  <!-- Each inner assembly's symbols are the .pdb beside it. -->
  <Target Name="PackInnerSymbols" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_PgProjInnerAssembly Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference')->WithMetadataValue('Extension', '.dll'))" />
      <TfmSpecificDebugSymbolsFile Include="@(_PgProjInnerAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" TargetPath="%(Filename).pdb" TargetFramework="$(TargetFramework)" Condition="Exists('%(RootDir)%(Directory)%(Filename).pdb')" />
    </ItemGroup>
  </Target>

</Project>
