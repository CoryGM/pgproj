<Project Sdk="Microsoft.NET.Sdk">

  <!-- A program that uses the PgProj.Engine package as a user's would (G-319): packaging/nuget/verify-package.sh builds, publishes, and runs it
       against a packed package before it is published. The version is the package's, given on the command line. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PgProj.Engine" Version="$(PgProjEngineVersion)" />
  </ItemGroup>

</Project>
